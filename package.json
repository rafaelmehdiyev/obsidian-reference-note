{
	"name": "reference-note",
	"version": "1.0.0",
	"description": "Create new notes by cloning frontmatter from any existing note.",
	"main": "main.js",
	"scripts": {
		"build": "node esbuild.config.mjs production",
		"dev": "node esbuild.config.mjs --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"esbuild": "^0.25.0",
		"obsidian": "latest",
		"typescript": "^5.4.0",
		"vitest": "^3.0.0"
	}
}
